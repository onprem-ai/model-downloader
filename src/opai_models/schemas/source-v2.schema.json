{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onprem.ai/models/source-v2.schema.json",
  "title": "OnPrem AI model source provenance",
  "description": "Durable source provenance with optional upstream per-file SHA-256 values. SHA256SUMS remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "files"],
  "properties": {
    "schema_version": {"const": 2},
    "source": {"$ref": "#/$defs/huggingFaceSource"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/sourceFile"}
    },
    "acquisition": {"$ref": "#/$defs/acquisition"},
    "upstream_metadata": {"$ref": "#/$defs/upstreamMetadata"}
  },
  "$defs": {
    "huggingFaceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "revision"],
      "properties": {
        "provider": {"const": "huggingface"},
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s\\x00-\\x1f\\x7f]+/[^/\\s\\x00-\\x1f\\x7f]+$",
          "maxLength": 256
        },
        "revision": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "null"}
          ]
        },
        "subdirectory": {
          "oneOf": [
            {"$ref": "#/$defs/relativePath"},
            {"type": "null"}
          ],
          "default": null
        }
      }
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "size": {"type": "integer", "minimum": 1, "maximum": 5497558138880},
        "upstream_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Non-authoritative SHA-256 reported or computed at acquisition time. SHA256SUMS remains authoritative."
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquired_at"],
      "properties": {
        "acquired_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    },
    "upstreamMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "licenses": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}, "uniqueItems": true},
        "library_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "pipeline_tag": {"type": "string", "minLength": 1, "maxLength": 128},
        "languages": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true}
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\\\x00-\\x1f\\x7f])[^/]+(?:/[^/]+)*$"
    }
  }
}
